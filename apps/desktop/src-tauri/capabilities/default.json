{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for buzz desktop app",
  "windows": ["main", "player"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "shell:allow-open"
  ]
}
